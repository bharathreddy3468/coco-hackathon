# Application Core Configuration
APP_NAME="Insurance Claims Decision Copilot"
APP_VERSION="1.0.0"
ENV=development
DEBUG=True

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Connection URL (Async SQLite by default)
DATABASE_URL="sqlite+aiosqlite:///./claims_copilot.db"

# Logging Settings (json format for structured production logs)
LOG_LEVEL=INFO
LOG_FORMAT=json

# AI Copilot Engine Settings
LLM_PROVIDER_MOCK=True
AUTO_APPROVAL_THRESHOLD=0.85
FRAUD_RISK_ALERT_THRESHOLD=0.70
